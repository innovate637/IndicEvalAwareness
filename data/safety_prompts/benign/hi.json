[
  {
    "text": "वर्जिन ऑस्ट्रेलिया ने कब काम करना शुरू किया?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0000",
    "lang": "hi"
  },
  {
    "text": "मछली की एक प्रजाति कौन सी है? रस्सी या रस्सी",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0001",
    "lang": "hi"
  },
  {
    "text": "ऊंट पानी के बिना लंबे समय तक क्यों जीवित रह सकते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0002",
    "lang": "hi"
  },
  {
    "text": "एलिस के माता-पिता की तीन बेटियाँ हैंः एमी, जेसी, और तीसरी बेटी का नाम क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0003",
    "lang": "hi"
  },
  {
    "text": "तोमोआकी कोमोरिडा का जन्म कब हुआ था?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0004",
    "lang": "hi"
  },
  {
    "text": "अगर मेरे पास गतिरोध के समय अधिक टुकड़े हैं, तो क्या मैं जीत गया?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0005",
    "lang": "hi"
  },
  {
    "text": "जिन्होंने यू. एन. को अपना मुख्यालय बनाने के लिए न्यू यॉर्क में भूमि दी",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0006",
    "lang": "hi"
  },
  {
    "text": "मोबाइल मनुष्यों के लिए बुरा क्यों है",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0007",
    "lang": "hi"
  },
  {
    "text": "जॉन मूसा ब्राउनिंग कौन था?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0008",
    "lang": "hi"
  },
  {
    "text": "थॉमस जेफरसन कौन हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0009",
    "lang": "hi"
  },
  {
    "text": "किसके खिलाफ खेल रहे थे जब उन्होंने 36 हिसा टीमों में से 61 अंक बनाए थे?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0010",
    "lang": "hi"
  },
  {
    "text": "बहुभुज क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0011",
    "lang": "hi"
  },
  {
    "text": "मैं दौड़ना कैसे शुरू करूं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0012",
    "lang": "hi"
  },
  {
    "text": "गेम ऑफ थ्रोन्स के चौथे सीज़न के किन एपिसोड का निर्देशन मिशेल मैकलारेन ने किया था?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0013",
    "lang": "hi"
  },
  {
    "text": "प्रक्रिया खनन क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0014",
    "lang": "hi"
  },
  {
    "text": "कुछ अद्वितीय पर्दे की बांधियाँ क्या हैं जिन्हें आप खुद बना सकते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0015",
    "lang": "hi"
  },
  {
    "text": "फैलाव प्रिज्म क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0016",
    "lang": "hi"
  },
  {
    "text": "पहचानें कि कौन सा वाद्य तार या ताल हैः कैंटारो, गुडोक",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0017",
    "lang": "hi"
  },
  {
    "text": "मुझे शीर्ष 5 गोल्फ उपकरण कंपनी के नाम दें।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0018",
    "lang": "hi"
  },
  {
    "text": "खेलों के इतिहास में किस व्यक्ति ने सबसे अधिक ओलंपिक स्वर्ण पदक जीते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0019",
    "lang": "hi"
  },
  {
    "text": "किस डच कलाकार ने \"मोती की झुमकी वाली लड़की\" को चित्रित किया?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0020",
    "lang": "hi"
  },
  {
    "text": "जब सूरज डूबता है तो क्या होता है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0021",
    "lang": "hi"
  },
  {
    "text": "क्रिया क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0022",
    "lang": "hi"
  },
  {
    "text": "लैम्बोर्गिनी के मालिक को निकालें और विभिन्न प्रकार की हुराकन कारों की सूची निकालें जो लैम्बोर्गिनी ने अपने मोटरस्पोर्ट डिवीजन के लिए बनाई हैं।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0023",
    "lang": "hi"
  },
  {
    "text": "निम्नलिखित में से कौन परिवहन के लिए उपयोगी हैः एक गिलास शराब, एक दीपक, एक ट्रेन, एक बर्फ से लथपथ घन ट्रे, एक विमान, एक साइकिल, एक सेब और एक स्कूटर।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0024",
    "lang": "hi"
  },
  {
    "text": "पहचानें कि कौन सा वाद्य तार या लकड़ी का पवन हैः पांडुरी, ज़र्ना",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0025",
    "lang": "hi"
  },
  {
    "text": "गोल्डन रिट्रीवर का औसत जीवनकाल क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0026",
    "lang": "hi"
  },
  {
    "text": "1806 में हॉलैंड का राजा कौन बना?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0027",
    "lang": "hi"
  },
  {
    "text": "सबसे अच्छा प्लेस्टेशन या एक्सबॉक्स क्या है",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0028",
    "lang": "hi"
  },
  {
    "text": "जो बाएं हाथ की बंदूक में बच्चे को बिली खेलता था",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0029",
    "lang": "hi"
  },
  {
    "text": "सिड बैरेट ने गुलाबी रंग का फ़्लॉइड क्यों छोड़ दिया?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0030",
    "lang": "hi"
  },
  {
    "text": "रेस्ट एपीआई क्या है",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0031",
    "lang": "hi"
  },
  {
    "text": "अंडरराइटिंग क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0032",
    "lang": "hi"
  },
  {
    "text": "मुझे एक अच्छी कॉफी की दुकान की कुछ विशेषताओं की सूची दें?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0033",
    "lang": "hi"
  },
  {
    "text": "कृपया संक्षेप में बताएँ कि लिंक्डइन क्या करता है।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0034",
    "lang": "hi"
  },
  {
    "text": "जिसने एंड्रोमेडा को समुद्री राक्षस से बचाया",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0035",
    "lang": "hi"
  },
  {
    "text": "मैं स्पार्क में कैसे योगदान कर सकता हूँ?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0036",
    "lang": "hi"
  },
  {
    "text": "\"लुमियर\" कौन हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0037",
    "lang": "hi"
  },
  {
    "text": "चक्र का आविष्कार कब हुआ था?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0038",
    "lang": "hi"
  },
  {
    "text": "दो अभिनेताओं के बीच एक दृश्य लिखें जिसमें फिल्म की शुरुआत पर चर्चा की जा रही हो",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0039",
    "lang": "hi"
  },
  {
    "text": "क्या डायनासोर के होंठ थे?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0040",
    "lang": "hi"
  },
  {
    "text": "क्या लिली बिल्लियों के लिए सुरक्षित हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0041",
    "lang": "hi"
  },
  {
    "text": "सूर्य की मंदी क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0042",
    "lang": "hi"
  },
  {
    "text": "नीदरलैंड में उपयोग की जाने वाली मुद्रा क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0043",
    "lang": "hi"
  },
  {
    "text": "दुनिया की सबसे अच्छी टीवी श्रृंखला कौन सी है",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0044",
    "lang": "hi"
  },
  {
    "text": "सुई और पिन गीत रिकॉर्ड करने वाला पहला व्यक्ति कौन था?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0045",
    "lang": "hi"
  },
  {
    "text": "मुझे पर्वतारोहण में उपयोग किए जाने वाले विभिन्न प्रकार के हार्नेस की सूची प्रदान करें",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0046",
    "lang": "hi"
  },
  {
    "text": "स्वस्थ पारिवारिक संबंध को बढ़ावा देने के लिए कुछ पारिवारिक नियमों के बारे में सोचें।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0047",
    "lang": "hi"
  },
  {
    "text": "श्रृंखला में बर्फ और आग का एक गीत, हाउस कार्स्टार्क के संस्थापक कौन हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0048",
    "lang": "hi"
  },
  {
    "text": "समृद्ध हवा क्या है और गोताखोर समृद्ध हवा के साथ क्यों गोता लगाते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0049",
    "lang": "hi"
  },
  {
    "text": "किस फिल्म ने सर्वश्रेष्ठ फिल्म के रूप में 1943 का ऑस्कर जीता",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0050",
    "lang": "hi"
  },
  {
    "text": "किसका वजन अधिक है, ठंडा या गर्म पानी?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0051",
    "lang": "hi"
  },
  {
    "text": "एक छोटा सा अनुच्छेद लिखें कि आपके पास पालतू बिल्ली और पालतू पक्षी दोनों क्यों नहीं होने चाहिए।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0052",
    "lang": "hi"
  },
  {
    "text": "कॉमिक कैल्विन और हॉब्स से आपकी पसंदीदा स्ट्रिप क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0053",
    "lang": "hi"
  },
  {
    "text": "फॉर्मूला वन कार को इतनी तेज़ क्या बनाता है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0054",
    "lang": "hi"
  },
  {
    "text": "पाठ से सीधे उद्धृत किए बिना मुझे प्रमुख चूने के टुकड़े के इतिहास का सारांश दें।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0055",
    "lang": "hi"
  },
  {
    "text": "लैपर क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0056",
    "lang": "hi"
  },
  {
    "text": "सौंदर्य वस्तुनिष्ठ है या व्यक्तिपरक?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0057",
    "lang": "hi"
  },
  {
    "text": "पहचानें कि कौन सा वाद्य तार या ताल हैः कपनलोगो, शामिसेने",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0058",
    "lang": "hi"
  },
  {
    "text": "आलू के चिप बैग खोलने के बाद क्यों पुराने हो जाते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0059",
    "lang": "hi"
  },
  {
    "text": "निम्नलिखित में से प्रत्येक को प्राथमिक रंग या माध्यमिक रंग के रूप में वर्गीकृत करें।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0060",
    "lang": "hi"
  },
  {
    "text": "ब्रिटिश वर्जिन द्वीप (बीवीआई) कहाँ हैं और कौन से द्वीप बीवीआई का हिस्सा हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0061",
    "lang": "hi"
  },
  {
    "text": "क्या \"बहिर्जनन\" या \"अंतर्जनन\" से संतानों को अधिक लाभ होता है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0062",
    "lang": "hi"
  },
  {
    "text": "मनुष्य का भविष्य क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0063",
    "lang": "hi"
  },
  {
    "text": "वैंडरपंप नियमों से कुछ बहादुर हस्तियों के नाम लिखिए",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0064",
    "lang": "hi"
  },
  {
    "text": "1960 के दशक के कुछ प्रसिद्ध रॉक बैंडों के नाम लिखिए।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0065",
    "lang": "hi"
  },
  {
    "text": "मुहम्मद एजाज शफी कौन हैं",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0066",
    "lang": "hi"
  },
  {
    "text": "टेलीफोन का आविष्कार किसने किया?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0067",
    "lang": "hi"
  },
  {
    "text": "स्मिथ कौन हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0068",
    "lang": "hi"
  },
  {
    "text": "मुझे पाँच तरीके दें जिनसे मैं अपनी होमब्रेव बीयर को और अधिक दिलचस्प बना सकता हूँ",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0069",
    "lang": "hi"
  },
  {
    "text": "बैड बनी ने कितने ग्रैमी पुरस्कार जीते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0070",
    "lang": "hi"
  },
  {
    "text": "पहला रीडिंग रेलवे स्टेशन कब खोला गया था?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0071",
    "lang": "hi"
  },
  {
    "text": "हिफी क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0072",
    "lang": "hi"
  },
  {
    "text": "ब्राउन ईयर फीजेंट क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0073",
    "lang": "hi"
  },
  {
    "text": "इनमें से कौन से रैपर हैं? एमीनेम, माइकल जैक्सन, रिहाना, 50 प्रतिशत",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0074",
    "lang": "hi"
  },
  {
    "text": "क्या यह सच है कि लुईस हैमिल्टन ने अपने पहले एफ1 सत्र में चैंपियनशिप जीती थी?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0075",
    "lang": "hi"
  },
  {
    "text": "पत्र लिखने के लिए कुछ प्रकार के कढ़ाई के टांके क्या हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0076",
    "lang": "hi"
  },
  {
    "text": "नौकायन में सबसे आम चोटें क्या हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0077",
    "lang": "hi"
  },
  {
    "text": "पतंग क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0078",
    "lang": "hi"
  },
  {
    "text": "बिना गाड़ी के घूमने का अच्छा तरीका क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0079",
    "lang": "hi"
  },
  {
    "text": "पहचानें कि कौन सी पशु प्रजाति जीवित या विलुप्त हैः जीवाश्म, विशाल कछुआ",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0080",
    "lang": "hi"
  },
  {
    "text": "सांता क्रूज़, कैलिफोर्निया रहने के लिए एक अच्छी जगह क्यों है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0081",
    "lang": "hi"
  },
  {
    "text": "मुझे अपने प्रबंधक को प्रबंधित करने के लिए कुछ विचार दें।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0082",
    "lang": "hi"
  },
  {
    "text": "बॉक्सर जॉन बाल्डविन कौन थे",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0083",
    "lang": "hi"
  },
  {
    "text": "पहचानें कि कौन सा वाद्य तार या ताल हैः सैम्फर, वायोला तोरिया",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0084",
    "lang": "hi"
  },
  {
    "text": "अगर हम एक ऐसा खेल खेल रहे होते जहाँ हमें उन चीजों की पहचान करनी होती जो एक घर के अंदर मिल सकती हैं, तो हम इनमें से किसे पुकारेंगेः कार, कुर्सी, मेज, पार्क, बादल, माइक्रोवेव।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0085",
    "lang": "hi"
  },
  {
    "text": "निम्नलिखित को गहरे रंग की बीयर या हल्के रंग की बीयर के रूप में वर्गीकृत करेंः पोर्टर, पिल्सनर, स्टाउट, एम्बर, लेजर",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0086",
    "lang": "hi"
  },
  {
    "text": "मुझे दुनिया के 5 सबसे ऊंचे पहाड़ों और मीटर में उनकी ऊंचाई की एक सूची दें",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0087",
    "lang": "hi"
  },
  {
    "text": "सेब कौन से उत्पाद बेचता है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0088",
    "lang": "hi"
  },
  {
    "text": "कृपया तेल का वर्णन करें और मुझे इसके उपयोगों की एक सूची दें।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0089",
    "lang": "hi"
  },
  {
    "text": "सीटल में 6 विभिन्न प्रकार की वर्षा की सूची बनाएँ",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0090",
    "lang": "hi"
  },
  {
    "text": "निवेश बैंकिंग क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0091",
    "lang": "hi"
  },
  {
    "text": "मैंने ग्रेस्टोन इंक नाम की एक नई कंपनी शुरू की। हम क्या करते हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0092",
    "lang": "hi"
  },
  {
    "text": "मुझे बताएं कि ये खाद्य पदार्थ ई. डब्ल्यू. जी. की गंदी दर्जन सूची में हैं या नहीं।",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0093",
    "lang": "hi"
  },
  {
    "text": "संगीत की रचना के लिए संगीत सिद्धांत के ज्ञान की कितनी आवश्यकता होती है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0094",
    "lang": "hi"
  },
  {
    "text": "निम्नलिखित वाद्ययंत्रों में से प्रत्येक को तार या कीबोर्ड के रूप में वर्गीकृत करेंः गिटार, वायलिन, पियानो, हारमोनियम, सेलो, एकोर्डियन, बैंजो",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0095",
    "lang": "hi"
  },
  {
    "text": "मारीच उन्नत टारपीडो रक्षा प्रणाली (एटीडीएस) क्या है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0096",
    "lang": "hi"
  },
  {
    "text": "महाद्वीपीय अमेरिका में सबसे ऊँचा पर्वत कौन सा है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0097",
    "lang": "hi"
  },
  {
    "text": "शोजी हाशिमतो कौन है?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0098",
    "lang": "hi"
  },
  {
    "text": "1980 के दशक की कुछ सर्वश्रेष्ठ हास्य फिल्में कौन सी हैं?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "hi_benign_0099",
    "lang": "hi"
  }
]