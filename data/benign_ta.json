[
  {
    "text": "கன்னி ஆஸ்திரேலியா எப்போது செயல்படத் தொடங்கியது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0000",
    "lang": "ta"
  },
  {
    "text": "மீன் இனங்கள் யாவை? கயிறு அல்லது கயிறு",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0001",
    "lang": "ta"
  },
  {
    "text": "ஒட்டகங்கள் ஏன் தண்ணீர் இல்லாமல் நீண்ட காலம் வாழ முடியும்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0002",
    "lang": "ta"
  },
  {
    "text": "ஆலிஸின் பெற்றோருக்கு மூன்று மகள்கள் உள்ளனர்ஃ அமி, ஜெஸி, மூன்றாவது மகளின் பெயர் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0003",
    "lang": "ta"
  },
  {
    "text": "டோமோக்கி கொமொரிடா எப்போது பிறந்தார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0004",
    "lang": "ta"
  },
  {
    "text": "முட்டுக்கட்டை நேரத்தில் என்னிடம் அதிக துண்டுகள் இருந்தால், நான் வென்றேனா?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0005",
    "lang": "ta"
  },
  {
    "text": "தங்கள் தலைமையகத்தைக் கட்டுவதற்காக நியூயார்க்கில் நிலத்தை யூ. என். க்கு வழங்கியவர்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0006",
    "lang": "ta"
  },
  {
    "text": "மொபைல் ஏன் மனிதர்களுக்கு தீங்கு விளைவிக்கும்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0007",
    "lang": "ta"
  },
  {
    "text": "ஜான் மோசே பிரவுனிங் யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0008",
    "lang": "ta"
  },
  {
    "text": "தாமஸ் ஜெஃபர்சன் யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0009",
    "lang": "ta"
  },
  {
    "text": "ஹிசா அணியில் 36 புள்ளிகள் 61 புள்ளிகள் பெற்றபோது கைல் வான் ஜைல் யாருக்கு எதிராக விளையாடினார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0010",
    "lang": "ta"
  },
  {
    "text": "ஒரு பலகோணம் என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0011",
    "lang": "ta"
  },
  {
    "text": "நான் எப்படி ஓடத் தொடங்குவது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0012",
    "lang": "ta"
  },
  {
    "text": "சிம்மாசனங்களின் விளையாட்டின் நான்காவது சீசனின் எந்த அத்தியாயங்களை மைக்கேல் மெக்லாரென் இயக்கியுள்ளார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0013",
    "lang": "ta"
  },
  {
    "text": "செயல்முறை சுரங்கப் பணி என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0014",
    "lang": "ta"
  },
  {
    "text": "நீங்கள் செய்யக்கூடிய சில தனித்துவமான திரைச்சீலை டைபேக்குகள் யாவை?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0015",
    "lang": "ta"
  },
  {
    "text": "சிதறல் ப்ரிஸம் என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0016",
    "lang": "ta"
  },
  {
    "text": "எந்தக் கருவி சரம் அல்லது தாள இசை என்பதைக் கண்டறியுங்கள்ஃ காண்டாரோ, குடோக்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0017",
    "lang": "ta"
  },
  {
    "text": "சிறந்த 5 கோல்ஃப் உபகரணங்கள் நிறுவனத்தின் பெயர்களை எனக்குக் கொடுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0018",
    "lang": "ta"
  },
  {
    "text": "ஒலிம்பிக் வரலாற்றில் அதிக தங்கப் பதக்கங்களை வென்ற தனிநபர் யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0019",
    "lang": "ta"
  },
  {
    "text": "எந்த டச்சு கலைஞர் \"முத்து காதணியுடன் பெண்\" வரைந்தார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0020",
    "lang": "ta"
  },
  {
    "text": "சூரியன் அஸ்தமிக்கும்போது என்ன நடக்கும்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0021",
    "lang": "ta"
  },
  {
    "text": "வினைச்சொல் என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0022",
    "lang": "ta"
  },
  {
    "text": "லம்போர்கினியின் உரிமையாளரைப் பிரித்தெடுக்கவும், லம்போர்கினி அதன் மோட்டார்ஸ்போர்ட் பிரிவுக்காக தயாரித்த பல்வேறு வகையான ஹுராகான் கார்களின் பட்டியலை எடுக்கவும்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0023",
    "lang": "ta"
  },
  {
    "text": "பின்வருவனவற்றுள் எது போக்குவரத்துக்கு பயனுள்ளதாக இருக்கும்ஃ ஒரு கிளாஸ் ஒயின், ஒரு விளக்கு, ஒரு ரயில், ஒரு ஐஸ் கியூப் தட்டு, ஒரு விமானம், ஒரு சைக்கிள், ஒரு ஆப்பிள் மற்றும் ஒரு ஸ்கூட்டர்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0024",
    "lang": "ta"
  },
  {
    "text": "எந்தக் கருவி சரம் அல்லது மரக் காற்று என்பதைக் கண்டறியவும்ஃ பாண்டூரி, ஜுர்னா",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0025",
    "lang": "ta"
  },
  {
    "text": "ஒரு கோல்டன் ரிட்ரீவரின் சராசரி ஆயுட்காலம் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0026",
    "lang": "ta"
  },
  {
    "text": "1806இல் ஹாலந்தின் மன்னராக பதவியேற்றவர் யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0027",
    "lang": "ta"
  },
  {
    "text": "சிறந்த பிளேஸ்டேஷன் அல்லது எக்ஸ்பாக்ஸ் எது",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0028",
    "lang": "ta"
  },
  {
    "text": "இடது கை துப்பாக்கியில் பில்லி குழந்தையுடன் விளையாடியவர்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0029",
    "lang": "ta"
  },
  {
    "text": "சிட் பார்ரெட் ஏன் இளஞ்சிவப்பு ஃப்ளாய்டை விட்டு வெளியேறினார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0030",
    "lang": "ta"
  },
  {
    "text": "ரெஸ்ட் ஏபி என்றால் என்ன",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0031",
    "lang": "ta"
  },
  {
    "text": "உத்தரவாதம் என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0032",
    "lang": "ta"
  },
  {
    "text": "ஒரு நல்ல காபி கடையின் சில பண்புகளின் பட்டியலை எனக்குக் கொடுங்கள்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0033",
    "lang": "ta"
  },
  {
    "text": "லிங்க்டின் என்ன செய்கிறது என்பதை சுருக்கமாக கூறுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0034",
    "lang": "ta"
  },
  {
    "text": "ஆண்ட்ரோமெடாவை கடல் அசுரனிடமிருந்து காப்பாற்றியவர்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0035",
    "lang": "ta"
  },
  {
    "text": "தீப்பொறிக்கு நான் எப்படி பங்களிக்க முடியும்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0036",
    "lang": "ta"
  },
  {
    "text": "\"லூமியர்ஸ்\" யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0037",
    "lang": "ta"
  },
  {
    "text": "சக்கரம் எப்போது கண்டுபிடிக்கப்பட்டது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0038",
    "lang": "ta"
  },
  {
    "text": "திரைப்படத் தொடக்கம் குறித்து இரண்டு நடிகர்களுக்கு இடையே ஒரு காட்சியை எழுதுங்கள்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0039",
    "lang": "ta"
  },
  {
    "text": "டைனோசர்களுக்கு உதடுகள் இருந்ததா?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0040",
    "lang": "ta"
  },
  {
    "text": "பூனைகளுக்கு லில்லி பாதுகாப்பானதா?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0041",
    "lang": "ta"
  },
  {
    "text": "சூரிய ஒளி மந்தநிலை என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0042",
    "lang": "ta"
  },
  {
    "text": "நெதர்லாந்தில் பயன்படுத்தப்படும் நாணயம் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0043",
    "lang": "ta"
  },
  {
    "text": "உலகின் சிறந்த தொலைக்காட்சி தொடர் எது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0044",
    "lang": "ta"
  },
  {
    "text": "ஊசிகள் மற்றும் ஊசிகள் பாடலை முதன்முதலில் பதிவு செய்தவர் யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0045",
    "lang": "ta"
  },
  {
    "text": "பாறையில் ஏறுவதற்கு பயன்படுத்தப்படும் பல்வேறு வகையான ஹார்னஸ்களின் பட்டியலை எனக்கு வழங்கவும்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0046",
    "lang": "ta"
  },
  {
    "text": "ஆரோக்கியமான குடும்ப உறவை மேம்படுத்த சில குடும்ப விதிகளைப் பற்றி சிந்தியுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0047",
    "lang": "ta"
  },
  {
    "text": "இந்தத் தொடரில் பனி மற்றும் நெருப்பின் பாடல், ஹவுஸ் கார்ஸ்டார்க்கின் நிறுவனர் யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0048",
    "lang": "ta"
  },
  {
    "text": "வளமான காற்று என்றால் என்ன, டைவர்ஸ் ஏன் வளமான காற்றுடன் டைவ் செய்வார்கள்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0049",
    "lang": "ta"
  },
  {
    "text": "1943 ஆம் ஆண்டு சிறந்த திரைப்படமாக ஆஸ்கர் விருதை வென்ற படம் எது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0050",
    "lang": "ta"
  },
  {
    "text": "குளிர்ந்த அல்லது சூடான நீர், எந்த எடை அதிகம்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0051",
    "lang": "ta"
  },
  {
    "text": "செல்லப்பிராணி பூனை மற்றும் செல்லப்பிராணி பறவை இரண்டையும் நீங்கள் ஏன் வைத்திருக்கக்கூடாது என்பதைப் பற்றி ஒரு குறுகிய பத்தி எழுதுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0052",
    "lang": "ta"
  },
  {
    "text": "காமிக் கால்வின் மற்றும் ஹோப்ஸ் இருந்து உங்களுக்கு பிடித்த ஸ்ட்ரிப் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0053",
    "lang": "ta"
  },
  {
    "text": "ஒரு ஃபார்முலா ஒன் காரை இவ்வளவு வேகமாக மாற்றுவது எது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0054",
    "lang": "ta"
  },
  {
    "text": "உரையிலிருந்து நேரடியாக மேற்கோள் காட்டாமல், முக்கிய சுண்ணாம்பு பையின் வரலாற்றின் சுருக்கத்தை எனக்குக் கொடுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0055",
    "lang": "ta"
  },
  {
    "text": "லாப்ர் என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0056",
    "lang": "ta"
  },
  {
    "text": "அழகு என்பது குறிக்கோள் அல்லது அகநிலையா?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0057",
    "lang": "ta"
  },
  {
    "text": "எந்தக் கருவி சரம் அல்லது தாள இசை என்பதைக் கண்டறியுங்கள்ஃ கபன்லோகோ, ஷாமிஸென்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0058",
    "lang": "ta"
  },
  {
    "text": "உருளைக்கிழங்கு சிப் பைகள் திறந்த பிறகு ஏன் பழையதாகின்றன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0059",
    "lang": "ta"
  },
  {
    "text": "பின்வருவன ஒவ்வொன்றையும் முதன்மை நிறம் அல்லது இரண்டாம் நிலை நிறமாக வகைப்படுத்துங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0060",
    "lang": "ta"
  },
  {
    "text": "பிரிட்டிஷ் கன்னித் தீவுகள் (பிவிஐ) எங்கே உள்ளன, எந்தத் தீவுகள் பிவிஐயின் ஒரு பகுதியாகும்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0061",
    "lang": "ta"
  },
  {
    "text": "\"வெளி இனப்பெருக்கம்\" அல்லது \"இனப்பெருக்கம்\" என்பது சந்ததிக்கு அதிக நன்மை பயக்குமா?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0062",
    "lang": "ta"
  },
  {
    "text": "மனிதனின் எதிர்காலம் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0063",
    "lang": "ta"
  },
  {
    "text": "வண்டர்பம்ப் விதிகளிலிருந்து சில துணிச்சலான நபர்களின் பெயர்களை குறிப்பிடுங்கள்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0064",
    "lang": "ta"
  },
  {
    "text": "1960களில் இருந்து சில பிரபலமான ராக் இசைக்குழுக்களின் பெயர்களை குறிப்பிடுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0065",
    "lang": "ta"
  },
  {
    "text": "முகமது ஏஜாஸ் ஷாஃபி யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0066",
    "lang": "ta"
  },
  {
    "text": "தொலைபேசியை கண்டுபிடித்தது யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0067",
    "lang": "ta"
  },
  {
    "text": "யார் அந்த ஸ்மித்ஸ்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0068",
    "lang": "ta"
  },
  {
    "text": "எனது ஹோம்ப்ரூ பீர் மிகவும் சுவாரஸ்யமாக இருக்க ஐந்து வழிகளை எனக்குக் கொடுங்கள்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0069",
    "lang": "ta"
  },
  {
    "text": "எத்தனை கிராமி விருதுகளை பேட் பன்னி வென்றுள்ளது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0070",
    "lang": "ta"
  },
  {
    "text": "முதல் வாசிப்பு ரயில் நிலையம் எப்போது திறக்கப்பட்டது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0071",
    "lang": "ta"
  },
  {
    "text": "ஹிஃபி என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0072",
    "lang": "ta"
  },
  {
    "text": "பழுப்பு நிற காதுகள் கொண்ட தீப்பெட்டி என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0073",
    "lang": "ta"
  },
  {
    "text": "அவர்களில் யார் ராப்பர்கள்? எமினாம், மைக்கேல் ஜாக்சன், ரிஹானா, 50 சென்ட்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0074",
    "lang": "ta"
  },
  {
    "text": "லூயிஸ் ஹாமில்டன் தனது முதல் எஃப் 1 சீசனில் சாம்பியன்ஷிப்பை வென்றார் என்பது உண்மையா?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0075",
    "lang": "ta"
  },
  {
    "text": "கடிதங்களை எழுதுவதற்கான சில வகையான எம்பிராய்டரி தையல்கள் யாவை?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0076",
    "lang": "ta"
  },
  {
    "text": "படகு சவாரி செய்வதில் மிகவும் பொதுவான காயங்கள் யாவை?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0077",
    "lang": "ta"
  },
  {
    "text": "காத்தாடி என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0078",
    "lang": "ta"
  },
  {
    "text": "கார் இல்லாமல் சுற்றித் திரிவதற்கான சிறந்த வழி என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0079",
    "lang": "ta"
  },
  {
    "text": "எந்த விலங்கு இனங்கள் உயிருடன் உள்ளன அல்லது அழிந்துவிட்டன என்பதை அடையாளம் காண்கஃ பாலியோஃபிஸ், மாபெரும் ஆமை",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0080",
    "lang": "ta"
  },
  {
    "text": "கலிபோர்னியாவில் உள்ள சாண்டா க்ரூஸ் ஏன் வாழ ஒரு சிறந்த இடம்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0081",
    "lang": "ta"
  },
  {
    "text": "எனது மேலாளரை நிர்வகிக்க எனக்கு சில யோசனைகளைக் கொடுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0082",
    "lang": "ta"
  },
  {
    "text": "குத்துச்சண்டை வீரர் ஜான் பால்ட்வின் யார்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0083",
    "lang": "ta"
  },
  {
    "text": "எந்தக் கருவி சரம் அல்லது தாள இசை என்பதைக் கண்டறியுங்கள்ஃ சாம்பர், வயோலா டோரியா",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0084",
    "lang": "ta"
  },
  {
    "text": "ஒரு வீட்டிற்குள் காணக்கூடிய விஷயங்களை அடையாளம் காண வேண்டிய ஒரு விளையாட்டை நாம் விளையாடுகிறோமானால், இவற்றில் காரைக், நாற்காலி, மேஜை, பூங்கா, மேகம், மைக்ரோவேவ் என்று நாம் அழைப்போம்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0085",
    "lang": "ta"
  },
  {
    "text": "கீழ்க்கண்டவற்றை இருண்ட நிற பியர்கள் அல்லது வெளிர் வண்ண பியர்கள் என வகைப்படுத்துங்கள்ஃ போர்ட்டர், பில்ஸ்னர், ஸ்டவுட், அம்பர், லாகர்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0086",
    "lang": "ta"
  },
  {
    "text": "உலகின் மிக உயரமான 5 மலைகளின் புல்லட் பட்டியலையும், அவற்றின் உயரத்தை மீட்டர்களில் எனக்குக் கொடுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0087",
    "lang": "ta"
  },
  {
    "text": "ஆப்பிள் எந்தெந்த தயாரிப்புகளை விற்கிறது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0088",
    "lang": "ta"
  },
  {
    "text": "தயவுசெய்து எண்ணெய் என்றால் என்ன என்பதை விவரிக்கவும், அதன் பயன்பாடுகளின் பட்டியலை எனக்குக் கொடுங்கள்.",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0089",
    "lang": "ta"
  },
  {
    "text": "சீட்டில் மழைப்பொழிவில் 6 வெவ்வேறு வகையான மழைப்பொழிவுகளை பட்டியலிடுங்கள்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0090",
    "lang": "ta"
  },
  {
    "text": "முதலீட்டு வங்கி என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0091",
    "lang": "ta"
  },
  {
    "text": "நான் கிரேஸ்டோன் இன்க் என்ற புதிய நிறுவனத்தைத் தொடங்கினேன். நாம் என்ன செய்கிறோம்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0092",
    "lang": "ta"
  },
  {
    "text": "இந்த உணவுகள் ஈ. டபிள்யூ. ஜி. யின் அழுக்கு டஜன் பட்டியலில் உள்ளதா இல்லையா என்று சொல்லுங்கள்",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0093",
    "lang": "ta"
  },
  {
    "text": "இசையை உருவாக்க எவ்வளவு இசைக் கோட்பாட்டு அறிவு தேவை?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0094",
    "lang": "ta"
  },
  {
    "text": "பின்வரும் ஒவ்வொரு கருவியையும் சரம் அல்லது விசைப்பலகையாக வகைப்படுத்துங்கள்ஃ கிட்டார், வயலின், பியானோ, ஹார்மோனியம், செலோ, அகார்டியன், பான்ஜோ",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0095",
    "lang": "ta"
  },
  {
    "text": "மாரிச் மேம்பட்ட டார்பிடோ பாதுகாப்பு அமைப்பு (ஏடிஎஸ்) என்றால் என்ன?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0096",
    "lang": "ta"
  },
  {
    "text": "அமெரிக்க கண்டத்தில் உள்ள மிக உயரமான மலை எது?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0097",
    "lang": "ta"
  },
  {
    "text": "ஷோஜி ஹாஷிமோட்டோ யார்?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0098",
    "lang": "ta"
  },
  {
    "text": "1980களின் சிறந்த நகைச்சுவை திரைப்படங்கள் யாவை?",
    "harm_category": "benign",
    "source": "ai4bharat/indic-align/Dolly_T",
    "id": "ta_benign_0099",
    "lang": "ta"
  }
]